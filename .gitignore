# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.open-next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
阿里云.txt

# vercel
.vercel

# local tutorial videos (hosted on COS)
/public/video/

# troubleshooting images (hosted on COS)
/content/troubleshooting/images/

# generated audit artifact (delete after review)
/preview-audit.html

# 临时审计/探测目录：一次性排查脚本 + GameBanana ZZZ 汉化管线的工作数据
# （profile/ 1500 个提交、pages/ 672 页等，约 2400 个文件 / 43MB）。都不入库，
# 否则每次 git status 都多出两千多条未跟踪文件。
/.tmp-audit/

# downloaded offline mod images (blur & re-upload work)
/offline-blur-src/

# script runtime logs
/scripts/logs/

# 互动计数器的运行时增量（游客点赞/浏览/收藏）
# 注意：data/engagement-baseline.json 是**故意提交**的部署种子，别一起忽略
/data/runtime/

# backup runtime artifacts (not committed; backups/images + backups/manifest.json ARE committed)
# backups/db 下的 dump 走 GitHub Release，不进 git
/backups/logs/
/backups/.tmp/
/backups/db/

# typescript
*.tsbuildinfo
next-env.d.ts


.git.broken/

.vercel
