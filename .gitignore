# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.open-next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
阿里云.txt

# vercel
.vercel

# local tutorial videos (hosted on COS)
/public/video/

# troubleshooting images (hosted on COS)
/content/troubleshooting/images/

# generated audit artifact (delete after review)
/preview-audit.html

# downloaded offline mod images (blur & re-upload work)
/offline-blur-src/

# script runtime logs
/scripts/logs/

# backup runtime artifacts (not committed; backups/images + backups/manifest.json ARE committed)
# backups/db 下的 dump 走 GitHub Release，不进 git
/backups/logs/
/backups/.tmp/
/backups/db/

# typescript
*.tsbuildinfo
next-env.d.ts


.git.broken/

.vercel
