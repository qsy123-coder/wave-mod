# ============================================================================
# WaveMod 香港反代 —— 每个 location 共用的回源指令
# ============================================================================
# 由 scripts/setup-hk-proxy.sh 渲染到 /etc/nginx/snippets/wavemod-proxy-common.conf
# 占位符：{{UPSTREAM_HOST}}
#
# 为什么不直接 proxy_set_header Host $host：
#   go.sunnyrose.xyz 不是挂在 Vercel 项目上的域名（DNS 指向香港机），
#   用 $host 回源会让 Vercel 找不到对应项目而返回 404。必须换成项目的
#   生产别名，同时用 X-Forwarded-Host 把访客看到的域名传过去。
# ============================================================================

proxy_pass https://wavemod_upstream;

proxy_http_version 1.1;
proxy_set_header Connection "";

# 回源一律要**未压缩**的响应体，压缩交给本机 nginx 做（见 wavemod-proxy.conf 的 gzip 段）。
#
# 为什么：proxy_cache_key 只有 `$host$request_uri`，**不含 Accept-Encoding**，而 Vercel
# 会按每个请求方协商 gzip / br。谁先来谁定调 —— 一个支持 br 的 Chrome 先请求，缓存里
# 存下的就是 br；之后只声明 gzip 的客户端（老 Android WebView、iOS ≤10 的 Safari、部分
# 国产内置浏览器、各种脚本）拿到的仍是 br。它们解不开这份响应体，浏览器直接报
# 「无法加载该网页」，而且连 CSS/JS 都不会再去请求 —— 表现为「进到首页等一会就变错误页」。
# 2026-11-01 实测：请求头写 `Accept-Encoding: gzip`，返回的却是 `Content-Encoding: br`；
# 对应访客在访问日志里只有文档一条记录，没有任何子资源请求。
proxy_set_header Accept-Encoding "";

proxy_set_header Host {{UPSTREAM_HOST}};
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;

proxy_ssl_server_name on;
proxy_ssl_name {{UPSTREAM_HOST}};
# 校验证书：上游是 Vercel，证书链正常；出问题时先看 error.log 再考虑临时关掉
proxy_ssl_verify on;
proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

proxy_connect_timeout 5s;
# 60s：Vercel 冷启动通常 1–2s，但极端情况会到几十秒；再长就让维护页接手，
# 别把访客挂在一个没有响应的连接上。
proxy_send_timeout 60s;
proxy_read_timeout 60s;

# 放在片段里而不是 server 级：nginx 的 add_header 不继承 ——
# 只要 location 自己有一条 add_header（例如 X-Cache-Status），server 级的就全丢了。
add_header Strict-Transport-Security "max-age=15552000" always;
