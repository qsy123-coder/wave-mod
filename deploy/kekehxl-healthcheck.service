[Unit]
Description=Mod 监测每日健康巡检（推送到微信）
Documentation=file:///home/ubuntu/kekehxl-watcher/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/kekehxl-watcher
ExecStart=/usr/bin/python3 /home/ubuntu/kekehxl-watcher/healthcheck.py
StandardOutput=append:/home/ubuntu/kekehxl-watcher/healthcheck.log
StandardError=append:/home/ubuntu/kekehxl-watcher/healthcheck.log

Nice=10
NoNewPrivileges=true
PrivateTmp=true
