# /etc/wavemod-engagement.env  （chmod 600，不要进 git）
#
# 应用侧（Vercel）用同样的 ENGAGEMENT_REMOTE_SECRET，并通过
#   ENGAGEMENT_STORE=remote
#   ENGAGEMENT_REMOTE_URL=https://go.sunnyrose.xyz/__engagement
# 接到这里。
ENGAGEMENT_REMOTE_SECRET=replace-with-48-char-random

ENGAGEMENT_STATE_PATH=/var/lib/wavemod-engagement/state.json
ENGAGEMENT_HOST=127.0.0.1
ENGAGEMENT_PORT=8791

# 可选：状态每 5 分钟镜像到 COS engagement/live.json（异地副本）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
