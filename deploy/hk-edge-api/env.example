# /etc/wavemod-edge-api.env  （chmod 600，不要进 git）
#
# ⚠️ 正常情况下这份文件由 install.sh 生成：它从 /etc/wavemod-engagement.env
# 抄 ENGAGEMENT_REMOTE_SECRET，两套服务共用同一个密钥。
# 手写容易和计数服务对不上，只在调试时手工建。

# 只监听本机：浏览器永远不直连，前面必须有 nginx
EDGE_API_HOST=127.0.0.1
EDGE_API_PORT=8792

# 落点固定走 remote —— 本机 8791 就是它的对端
ENGAGEMENT_STORE=remote
ENGAGEMENT_REMOTE_URL=http://127.0.0.1:8791
ENGAGEMENT_REMOTE_SECRET=replace-with-the-same-value-as-engagement-env

# 展示口径（基线 + 浏览量 ×65%）用的种子数据
ENGAGEMENT_BASELINE_PATH=/opt/wavemod-edge-api/engagement-baseline.json
