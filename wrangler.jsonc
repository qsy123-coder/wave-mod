{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wave-mod",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    // Cloudflare Workers 流水线目前是禁用状态（超出 3 MiB 限制）。
    // 迁移后应用只读 DATABASE_URL（自建 PostgreSQL），Workers 无法直接用它；
    // 将来若重启这条流水线，需要单独评估 Hyperdrive 或 HTTP 数据网关。
    "NEXT_PUBLIC_SITE_URL": "https://go.sunnyrose.xyz",
    "ALIYUN_OSS_REGION": "oss-cn-hangzhou",
    "ALIYUN_OSS_BUCKET": "wave-mod",
    "ALIYUN_OSS_ENDPOINT": "https://oss-cn-hangzhou.aliyuncs.com",
    "ALIYUN_DYPNS_ENDPOINT": "dypnsapi.aliyuncs.com",
    "ALIYUN_DYSMS_ENDPOINT": "dysmsapi.aliyuncs.com",
    "ALIYUN_SMS_ENDPOINT": "dypnsapi.aliyuncs.com",
    "COS_BUCKET": "wave-mod-preview-1327973389",
    "COS_REGION": "ap-guangzhou"
  }
}
