[Unit]
Description=Afdian Watcher - afdian.com 作者发帖更新监测
Documentation=file:///home/ubuntu/kekehxl-watcher/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/kekehxl-watcher
# 纯 HTTP，走 afdian.com/api/*（匿名可用的三个接口）。
# 站点是纯 SPA（无 SSR），抓页面拿不到东西 —— 别改成抓 HTML。
# 不需要浏览器，也没有任何凭据（与 Patreon 那个来源不同）。
ExecStart=/usr/bin/python3 /home/ubuntu/kekehxl-watcher/run_afdian_forever.py
Restart=always
RestartSec=30
# 日志
StandardOutput=append:/home/ubuntu/kekehxl-watcher/afdian-watcher.log
StandardError=append:/home/ubuntu/kekehxl-watcher/afdian-watcher.log
# 资源与安全
Nice=10
MemoryMax=200M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
